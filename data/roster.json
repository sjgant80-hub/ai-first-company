{
 "kind": "ai-first-company-roster",
 "v": 1,
 "from": "Simon's bot-team spec, 2026-11-01, §1. One role per bot; tools fenced per bot; anything public, paid or risky waits for Simon.",
 "tools": {
  "feed.read": { "class": "read", "what": "read the shared feed" },
  "memory.read": { "class": "read", "what": "read Kar's memory" },
  "repo.read": { "class": "read", "what": "read code and receipts in the company's repos" },
  "web.read": { "class": "read", "what": "read public web pages" },
  "x.read": { "class": "read", "what": "read public posts on X" },
  "marketplace.read": { "class": "read", "what": "read marketplace dashboards (Agensi, SkillHQ)" },
  "sales.read": { "class": "read", "what": "read sales and payout status" },
  "receipt.rehash": { "class": "read", "what": "re-hash a receipt at its pinned commit" },
  "tests.rerun": { "class": "read", "what": "re-run a receipt's tests on a clean copy" },
  "feed.write": { "class": "write", "what": "add a line to the shared feed (through the writer)" },
  "memory.write": { "class": "write", "what": "write Kar's memory" },
  "status.write": { "class": "write", "what": "add a line to the daily log (STATUS.md)" },
  "rollup.write": { "class": "write", "what": "write the daily rollup (AGENT_FEED.md)" },
  "report.write": { "class": "write", "what": "write a report for Simon" },
  "task.assign": { "class": "write", "what": "give another bot a task through the feed" },
  "branch.write": { "class": "write", "what": "commit to a working branch" },
  "code.push": { "class": "write", "what": "push a working branch to a shared repo (never main)" },
  "seal.write": { "class": "write", "what": "commit sealed claims before the code" },
  "tests.run": { "class": "write", "what": "run the tests" },
  "gate.run": { "class": "write", "what": "run the mutation gate" },
  "preflight.run": { "class": "write", "what": "run the build preflight" },
  "pr.open": { "class": "write", "what": "open a pull request for review" },
  "local-model.call": { "class": "write", "what": "ask the local model" },
  "frontier-model.call": { "class": "write", "what": "ask the rented frontier model" },
  "listing.draft": { "class": "write", "what": "draft a marketplace listing" },
  "post.draft": { "class": "write", "what": "draft a post" },
  "reply.draft": { "class": "write", "what": "draft a reply" },
  "clip.draft": { "class": "write", "what": "draft a video clip" },
  "lead.log": { "class": "write", "what": "log a lead" },
  "gap.log": { "class": "write", "what": "log a gap in the market or the estate" },
  "intake.write": { "class": "write", "what": "record a client's intake" },
  "agreement.draft": { "class": "write", "what": "draft a baseline agreement for Simon" },
  "pack.build": { "class": "write", "what": "build a delivery pack" },
  "card.forge": { "class": "write", "what": "forge a Fall Kard with fallkard-forge" },
  "card.verify": { "class": "write", "what": "verify a Fall Kard" },
  "verdict.write": { "class": "write", "what": "write an auditor verdict (PASS / FLAG / FAIL)" },
  "pause.write": { "class": "write", "what": "pause a bot or the whole team (the kill switch)" },
  "card.sign": { "class": "gated", "what": "sign a Fall Kard" },
  "main.merge": { "class": "outward", "what": "merge or push to main" },
  "release.publish": { "class": "outward", "what": "publish a release or a live page" },
  "post.publish": { "class": "outward", "what": "publish a post" },
  "reply.publish": { "class": "outward", "what": "publish a reply" },
  "dm.send": { "class": "outward", "what": "send a direct message" },
  "email.send": { "class": "outward", "what": "send an email" },
  "listing.submit": { "class": "outward", "what": "submit a listing to a marketplace" },
  "price.set": { "class": "outward", "what": "set or change a price" },
  "terms.accept": { "class": "outward", "what": "accept a platform's or a client's terms" },
  "client.send": { "class": "outward", "what": "send anything to a client" },
  "quote.send": { "class": "outward", "what": "give a client a quote" },
  "contract.sign": { "class": "outward", "what": "sign an agreement" },
  "promise.make": { "class": "outward", "what": "promise a client a result or a date" },
  "money.spend": { "class": "outward", "what": "spend or move money" },
  "decision.approve": { "class": "outward", "what": "approve work for release (Simon's alone)" }
 },
 "personas": [
  {
   "id": "kar", "name": "Kar", "role": "Conductor: reads the feed, assigns the work, keeps the memory, writes the daily rollup and the weekly report.",
   "runs_on": "Simon's laptop (Claude Code, with the local models)", "runtime": { "model": "claude-opus-5-5", "config": "kar-conductor" },
   "tools": ["feed.read", "feed.write", "memory.read", "memory.write", "status.write", "rollup.write", "report.write", "task.assign", "repo.read", "web.read", "local-model.call", "frontier-model.call", "pause.write"],
   "forbidden": ["post.publish", "reply.publish", "listing.submit", "release.publish", "money.spend", "code.push", "main.merge", "verdict.write", "decision.approve"],
   "content": ["plain-language"],
   "owns": ["the daily rollup", "the weekly report", "task assignments", "Kar's memory"]
  },
  {
   "id": "builder", "name": "Builder", "role": "Builds against the gate: seals the claims before the code, runs the tests and the mutation gate.",
   "runs_on": "Simon's laptop (Claude Code)", "runtime": { "model": "claude-opus-5-5", "config": "builder" },
   "tools": ["feed.read", "feed.write", "repo.read", "web.read", "branch.write", "code.push", "seal.write", "tests.run", "gate.run", "preflight.run", "pr.open", "local-model.call", "frontier-model.call",
    { "tool": "main.merge", "when": ["auditor-pass", "simon-go"] }, { "tool": "release.publish", "when": ["auditor-pass", "simon-go"] }],
   "forbidden": ["verdict.write", "decision.approve", "money.spend", "post.publish", "listing.submit"],
   "content": ["plain-language"],
   "owns": ["code", "sealed claims", "test suites", "mutation-gate receipts", "pull requests"]
  },
  {
   "id": "money-time", "name": "Money time", "role": "Marketplace listings, sales tracking, payout blockers and the weekly money report.",
   "runs_on": "Grok Bot's computer", "runtime": { "model": "grok", "config": "money-time" },
   "tools": ["feed.read", "feed.write", "marketplace.read", "sales.read", "web.read", "listing.draft", "report.write",
    { "tool": "listing.submit", "when": ["simon-go"] }, { "tool": "price.set", "when": ["simon-go"] }, { "tool": "terms.accept", "when": ["simon-go"] }],
   "forbidden": ["money.spend", "post.publish", "dm.send", "contract.sign"],
   "content": ["no-earnings-claims", "no-crypto-wording", "plain-language"],
   "owns": ["listing drafts", "the sales log", "the payout-blocker list", "the weekly money report"]
  },
  {
   "id": "reach", "name": "Reach", "role": "Drafts posts, clips and replies for Simon to approve.",
   "runs_on": "Grok Bot's computer", "runtime": { "model": "grok", "config": "reach" },
   "tools": ["feed.read", "feed.write", "x.read", "web.read", "post.draft", "reply.draft", "clip.draft",
    { "tool": "post.publish", "when": ["simon-go"] }, { "tool": "reply.publish", "when": ["simon-go"] }],
   "forbidden": ["dm.send", "money.spend", "listing.submit"],
   "content": ["no-earnings-claims", "no-crypto-wording", "plain-language"],
   "owns": ["post drafts", "clip drafts", "reply drafts"]
  },
  {
   "id": "scout", "name": "Scout", "role": "Read-only watching: logs leads and gaps, never contacts anyone.",
   "runs_on": "Grok Bot's computer (reading X) and the local model (reading the web)", "runtime": { "model": "grok", "config": "scout" },
   "tools": ["feed.read", "feed.write", "x.read", "web.read", "marketplace.read", "lead.log", "gap.log"],
   "forbidden": ["dm.send", "reply.publish", "post.publish", "email.send", "client.send"],
   "content": ["plain-language"],
   "owns": ["the lead log", "the gap log"]
  },
  {
   "id": "client-lead", "name": "Client lead", "role": "Intake, baseline agreements and delivery packs for mint-a-node and grow-a-brain clients.",
   "runs_on": "Simon's laptop (Claude Code)", "runtime": { "model": "claude-opus-5-5", "config": "client-lead" },
   "tools": ["feed.read", "feed.write", "repo.read", "intake.write", "agreement.draft", "pack.build", "local-model.call", { "tool": "client.send", "when": ["simon-go"] }],
   "forbidden": ["quote.send", "contract.sign", "promise.make", "price.set", "money.spend"],
   "content": ["no-earnings-claims", "plain-language"],
   "owns": ["intake records", "baseline agreement drafts", "delivery packs"]
  },
  {
   "id": "card-keeper", "name": "Card Keeper", "role": "Forges and verifies signed Fall Kards with fallkard-forge.",
   "runs_on": "Grok Bot's computer", "runtime": { "model": "grok", "config": "card-keeper" },
   "tools": ["feed.read", "feed.write", "repo.read", "card.forge", "card.verify", { "tool": "card.sign", "when": ["auditor-pass"] }],
   "forbidden": ["post.publish", "money.spend", "main.merge"],
   "content": ["plain-language"],
   "owns": ["forged cards", "card verification records"]
  },
  {
   "id": "auditor", "name": "Auditor", "role": "The separate judge: checks claims against receipts, re-runs tests, compares the tools a bot used with its list, checks for overclaims, plain language and hidden assumptions, and writes PASS, FLAG or FAIL with evidence. It never builds or fixes anything.",
   "runs_on": "Simon's laptop, as its own process", "runtime": { "model": "qwen2.5:7b", "config": "auditor-v1: deterministic checks first; the local model may only add a flag" },
   "tools": ["feed.read", "feed.write", "repo.read", "receipt.rehash", "tests.rerun", "local-model.call", "verdict.write", "pause.write"],
   "forbidden": ["branch.write", "code.push", "main.merge", "release.publish", "seal.write", "card.forge", "listing.draft", "post.draft", "reply.draft", "pack.build", "agreement.draft", "frontier-model.call"],
   "content": ["plain-language"],
   "owns": ["verdict lines"]
  }
 ]
}
